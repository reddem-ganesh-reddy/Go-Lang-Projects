
# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# Service Ports
DEPARTMENT_SERVICE_PORT=8081
EMPLOYEE_SERVICE_PORT=8082
AUTH_SERVICE_PORT=8083
API_GATEWAY_PORT=8080

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_SSLMODE=disable

# Database Names
DEPARTMENT_DB_NAME=department_db
EMPLOYEE_DB_NAME=employee_db

# Consul Configuration
CONSUL_ADDRESS=127.0.0.1:8500
CONSUL_SCHEME=http
CONSUL_DATACENTER=dc1

# Service URLs
DEPARTMENT_SERVICE_URL=http://localhost:8081
EMPLOYEE_SERVICE_URL=http://localhost:8082
AUTH_SERVICE_URL=http://localhost:8083

# HTTP Client Configuration
HTTP_CLIENT_TIMEOUT_SECONDS=5
HTTP_CLIENT_MAX_RETRIES=3
HTTP_CLIENT_RETRY_DELAY_MILLIS=500

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30

# Authentication Configuration
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change_this_admin_password

AUTH_EMPLOYEE_USERNAME=emp
AUTH_EMPLOYEE_PASSWORD=change_this_employee_password

# JWT Configuration
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRATION_MINUTES=60
